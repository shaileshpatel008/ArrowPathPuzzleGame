<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: progress moves to a new phone and is backed up to the
     player's Google account (Android Auto Backup). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
